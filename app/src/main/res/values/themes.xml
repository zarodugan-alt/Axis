<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- No AppCompat in P1 (pure Compose) so we extend the platform theme.
         windowBackground kills the white cold-start flash; the Compose UI
         draws edge-to-edge over it (MainActivity.enableEdgeToEdge). -->
    <style name="Theme.Axis" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/bg_primary</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>
