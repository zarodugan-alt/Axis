# Android / Gradle
*.iml
.gradle/
local.properties
.idea/
.DS_Store
build/
*/build/
captures/
.externalNativeBuild/
.cxx/
*.hprof

# AXIS: OFL variable fonts are downloaded at build time by :ui:downloadFonts
